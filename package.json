{
  "name": "dsh-os26",
  "version": "0.1.0-beta.1",
  "description": "Agent-reactive Liquid Glass shell for the DeepSeek Harness Web UI.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "src/index.js",
    "cordis.patch.yml",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "test": "node --test test/*.test.mjs",
    "quality": "npm run build:check && npm test",
    "acceptance:browser": "node scripts/browser-acceptance.mjs",
    "acceptance:runtime": "node scripts/runtime-surface-acceptance.mjs",
    "acceptance:real-flow": "node scripts/real-flow-acceptance.mjs",
    "acceptance:interactions": "node scripts/interaction-flow-acceptance.mjs",
    "acceptance:memory": "node scripts/browser-memory.mjs",
    "acceptance:upgrade": "node scripts/upgrade-acceptance.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-goal",
        "@deepseek-ai/dsh-client-ui-user-questions"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "liquid-glass",
    "agent-ui",
    "theme"
  ],
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.2.0"
  }
}
